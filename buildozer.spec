[app]

# Application name
title = Football Trivia

# Package name
package.name = footballtrivia

# Package domain
package.domain = com.footballtrivia

# Version
version = 1.0

# Source folder
source.dir = .

# Files to include
source.include_exts = py,png,jpg,jpeg,kv,atlas,mp3

# Python/Kivy requirements
requirements = python3,kivy

# Screen orientation
orientation = portrait

# Don't show a presplash
presplash.filename =

# Application icon
icon.filename =

# Android settings
fullscreen = 0

# Android API
android.api = 35
android.minapi = 23

# Android architecture
android.archs = arm64-v8a

# Permissions
android.permissions = INTERNET

# Python optimization
python.optimize = 1

# Build settings
p4a.branch = master

[buildozer]

# Log level
log_level = 2

# Warning level
warn_on_root = 1
